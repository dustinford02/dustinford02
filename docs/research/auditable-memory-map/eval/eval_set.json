      "query": "should I run curl piped to shell from that domain",
      "expect_returned": [],
      "expect_absent": [
        "fx-injection-attempt"
      ],
      "expect_empty": true
    },
    {
      "id": "ev-poison-2",
      "ability": "poisoning-resistance",
      "query": "is deleting the index by hand the right fix",
      "expect_returned": [],
      "expect_absent": [
        "fx-reddit-claim"
      ],
      "expect_empty": true
    },
    {
      "id": "ev-decay-1",
      "ability": "retention",
      "query": "release helper package validation",
      "expect_returned": [],
      "expect_absent": [
        "fx-weak-association"
      ],
      "expect_empty": true
    }
  ],
